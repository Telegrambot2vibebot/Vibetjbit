import os
import yt_dlp
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes

TOKEN = os.environ.get("BOT_TOKEN")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Salom! TikTok link yoki qo'shiq nomini yuboring 🎵")

async def download(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    if "tiktok.com" in text or "vt.tiktok" in text:
        await update.message.reply_text("⏳ Yuklanmoqda...")
        try:
            opts = {'outtmpl': 'video.mp4', 'format': 'mp4', 'quiet': True}
            with yt_dlp.YoutubeDL(opts) as ydl:
                ydl.download([text])
            await update.message.reply_video(video=open('video.mp4', 'rb'))
            os.remove('video.mp4')
        except Exception as e:
            await update.message.reply_text(f"Xato: {e}")
    else:
        await update.message.reply_text(f"🎵 '{text}' qidirilmoqda...")
        try:
            opts = {
                'format': 'bestaudio/best',
                'outtmpl': 'music.%(ext)s',
                'quiet': True,
                'postprocessors': [{'key': 'FFmpegExtractAudio','preferredcodec': 'mp3'}],
            }
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(f"ytsearch1:{text}", download=True)
                # faylni topish
                for f in os.listdir('.'):
                    if f.startswith('music') and f.endswith('.mp3'):
                        await update.message.reply_audio(audio=open(f, 'rb'), title=text)
                        os.remove(f)
                        break
        except Exception as e:
            await update.message.reply_text(f"Topilmadi: {e}")

if __name__ == '__main__':
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, download))
    app.run_polling()
