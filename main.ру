import os
import telebot
import yt_dlp

TOKEN = os.environ.get("BOT_TOKEN")
bot = telebot.TeleBot(TOKEN)

@bot.message_handler(commands=['start'])
def start(message):
    bot.reply_to(message, "Salom xo'jayin! TikTok link yoki musiqa nomini yuboring 🎵")

@bot.message_handler(func=lambda m: True)
def handle(message):
    text = message.text
    if "tiktok.com" in text or "vt.tiktok" in text:
        bot.reply_to(message, "⏳ Yuklanmoqda...")
        try:
            ydl_opts = {'outtmpl': 'video.mp4', 'format': 'mp4', 'quiet': True}
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                ydl.download([text])
            with open('video.mp4', 'rb') as f:
                bot.send_video(message.chat.id, f)
            os.remove('video.mp4')
        except Exception as e:
            bot.reply_to(message, f"Xato: {e}")
    else:
        bot.reply_to(message, f"🎵 '{text}' qidirilmoqda...")
        try:
            ydl_opts = {
                'format': 'bestaudio/best',
                'outtmpl': 'music.%(ext)s',
                'quiet': True,
                'postprocessors': [{'key': 'FFmpegExtractAudio','preferredcodec': 'mp3'}],
                'postprocessor_args': ['-ar', '44100']
            }
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                ydl.download([f"ytsearch1:{text}"])

            for file in os.listdir('.'):
                if file.startswith("music") and file.endswith(".mp3"):
                    with open(file, 'rb') as f:
                        bot.send_audio(message.chat.id, f, title=text)
                    os.remove(file)
                    break
        except Exception as e:
            bot.reply_to(message, f"Topilmadi: {e}")

print("Bot ishga tushdi...")
bot.infinity_polling()
