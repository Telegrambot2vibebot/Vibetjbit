import telebot
from yt_dlp import YoutubeDL
import os
TOKEN = "8856609454:AAGObMKBRles64u5FBVwkgldnVVUyo_Bc90"
bot = telebot.TeleBot(TOKEN)
@bot.message_handler(commands=['start'])
def start(m):
    bot.send_message(m.chat.id, "Salom! Link yubor 🎧")
@bot.message_handler(func=lambda m: True)
def yukla(m):
    if 'http' not in m.text:
        return
    bot.send_message(m.chat.id, "Yuklayapman...")
    try:
        ydl_opts = {'format': 'best', 'outtmpl': '%(title)s.%(ext)s', 'quiet': True}
        with YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(m.text, download=True)
            file = ydl.prepare_filename(info)
            with open(file, 'rb') as f:
                bot.send_video(m.chat.id, f, caption="@vibetjbot")
            os.remove(file)
    except Exception as e:
        bot.send_message(m.chat.id, f"Xato: {e}")
bot.infinity_polling()
